<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".a_authentication.uiAuth.RegisterUser">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_large">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_logo_loginId"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:src="@drawable/chatting"
            android:layout_marginTop="@dimen/radius_medium"
            android:contentDescription="@string/app_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.ChatAppCircle" />

        <TextView
            android:id="@+id/textTitle_login_id"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/login_account"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_logo_loginId" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLayoutErrorLoginId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeColor="?attr/colorError"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/textTitle_login_id"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="13dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgClearGeneralErrorLoginId"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_cancel"
                    android:layout_margin="3dp"
                    android:backgroundTint="#603436"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.ChatAppCircle" />

                <TextView
                    android:id="@+id/tvShowGeneralErrorLoginId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorError"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_margin="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/emailInput_login_id"
            style="@style/Widget.ChatApp.TextInput"
            android:hint="@string/et_email"
            app:layout_constraintTop_toBottomOf="@+id/cardLayoutErrorLoginId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/spacing_medium"
            app:startIconDrawable="@drawable/ic_email_">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email_loginId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvEmailLoginErrorId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/emailInput_login_id"
            app:layout_constraintEnd_toEndOf="@+id/emailInput_login_id"
            app:layout_constraintStart_toStartOf="@+id/emailInput_login_id" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/passwordInput_login_id"
            style="@style/Widget.ChatApp.TextInput"
            android:hint="@string/et_password"
            app:layout_constraintTop_toBottomOf="@+id/tvEmailLoginErrorId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/spacing_small"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password_loginId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvPasswordLoginErrorId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/passwordInput_login_id"
            app:layout_constraintEnd_toEndOf="@+id/passwordInput_login_id"
            app:layout_constraintStart_toStartOf="@+id/passwordInput_login_id" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login_id"
            style="@style/Widget.ChatApp.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/btn_login"
            app:icon="@drawable/ic_login_"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPasswordLoginErrorId" />

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:id="@+id/progress_login_Id"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@+id/btn_login_id"
            app:layout_constraintBottom_toBottomOf="@+id/btn_login_id"
            app:layout_constraintStart_toStartOf="@+id/btn_login_id"
            app:layout_constraintEnd_toEndOf="@+id/btn_login_id" />

        <TextView
            android:id="@+id/isHaveAccountText_loginId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/btn_to_register"
            style="@style/TextAppearance.ChatApp.Body"
            app:layout_constraintTop_toBottomOf="@+id/btn_login_id"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/radius_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_to_register_id_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="@string/create_account"
            app:icon="@drawable/ic_add_account"
            app:layout_constraintBottom_toBottomOf="@+id/isHaveAccountText_loginId"
            app:layout_constraintStart_toEndOf="@+id/isHaveAccountText_loginId"
            app:layout_constraintTop_toTopOf="@+id/isHaveAccountText_loginId" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>