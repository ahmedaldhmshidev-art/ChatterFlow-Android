<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"

    android:layout_height="wrap_content"

    android:paddingHorizontal="@dimen/spacing_small"
    android:paddingVertical="3dp">


    <com.google.android.material.card.MaterialCardView

        android:id="@+id/bubbleReceive_itemReceiver"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        app:cardCornerRadius="18dp"

        app:cardElevation="0dp"

        app:cardBackgroundColor="?attr/colorSurface"

        app:strokeWidth="1dp"

        app:strokeColor="@color/cardview_shadow_end_color"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toTopOf="parent"
        >


        <LinearLayout

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:maxWidth="300dp"

            android:orientation="vertical"

            android:padding="10dp">


            <TextView

                android:id="@+id/tv_message_item_receiver"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:maxWidth="280dp"

                android:textColor="?attr/colorOnSurface"
                android:text="@string/msg_receiver"

                style="@style/TextAppearance.ChatApp.Body"/>


            <!-- Edited -->

            <TextView

                android:id="@+id/tv_edited_item_receiver"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="@string/edited"

                android:textSize="11sp"

                android:textStyle="italic"

                android:textColor="?attr/colorOutline"

                android:visibility="gone"/>


            <TextView

                android:id="@+id/tv_time_item_receiver"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_gravity="end"


                android:textSize="11sp"

                android:textColor="?attr/colorOutline"/>


        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>