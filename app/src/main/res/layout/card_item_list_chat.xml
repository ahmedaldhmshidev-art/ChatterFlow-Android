<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:foreground="?attr/selectableItemBackground"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="70dp"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingEnd="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_small"
    android:paddingBottom="@dimen/spacing_small"
    android:background="?attr/selectableItemBackground">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_itemListChat_id"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:src="@drawable/ic_user_info"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ChatAppCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tv_name_itemListChat_Id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="?attr/colorOnSurface"
        style="@style/TextAppearance.AppCompat.Medium"
        app:layout_constraintStart_toEndOf="@+id/img_itemListChat_id"
        android:text="@string/et_name"
        app:layout_constraintEnd_toStartOf="@+id/tv_Time_itemListChat_id"
        app:layout_constraintTop_toTopOf="@id/img_itemListChat_id"
        android:layout_marginStart="@dimen/spacing_medium" />

    <TextView
        android:id="@+id/tv_Time_itemListChat_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOutline"
        style="@style/TextAppearance.ChatApp.Caption"
        app:layout_constraintTop_toTopOf="@id/tv_name_itemListChat_Id"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_name_itemListChat_Id" />

    <LinearLayout
        android:id="@+id/layout_lastMessageId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="@+id/tv_name_itemListChat_Id"
        app:layout_constraintTop_toBottomOf="@+id/tv_name_itemListChat_Id"
        app:layout_constraintEnd_toStartOf="@+id/tv_unread_itemListChat_id"
        app:layout_constraintBottom_toBottomOf="@id/img_itemListChat_id"
        android:layout_marginTop="@dimen/spacing_small">

        <TextView
            android:id="@+id/tv_status_itemListChat_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="✔✔✔"
            android:textSize="11sp"
            android:gravity="center"
            android:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tv_message_itemListChat_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_account_description"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="5dp"
            android:textColor="?attr/colorOutline"
            style="@style/TextAppearance.ChatApp.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_unread_itemListChat_id"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:textColor="?colorOnPrimary"
        android:background="@drawable/bg_unread_badge"
        android:visibility="gone"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
