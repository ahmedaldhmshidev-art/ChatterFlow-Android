<?xml version="1.0" encoding="utf-8"?>

<resources>


    <!-- Button -->

    <style
        name="Widget.ChatApp.Button"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">
            @dimen/button_height
        </item>

        <item name="cornerRadius">
            @dimen/radius_medium
        </item>

        <item name="android:textAllCaps">
            false
        </item>

    </style>



    <!-- Outlined Button -->

    <style
        name="Widget.ChatApp.OutlinedButton"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="android:minHeight">
            @dimen/button_height
        </item>

        <item name="cornerRadius">
            @dimen/radius_medium
        </item>

        <item name="android:textAllCaps">
            false
        </item>

    </style>



    <!-- Text Input -->

    <style
        name="Widget.ChatApp.TextInput"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxCornerRadiusTopStart">
            @dimen/radius_medium
        </item>

        <item name="boxCornerRadiusTopEnd">
            @dimen/radius_medium
        </item>

        <item name="boxCornerRadiusBottomStart">
            @dimen/radius_medium
        </item>

        <item name="boxCornerRadiusBottomEnd">
            @dimen/radius_medium
        </item>

    </style>



    <!-- Card -->

    <style
        name="Widget.ChatApp.Card"
        parent="Widget.Material3.CardView.Elevated">

        <item name="cardCornerRadius">
            @dimen/radius_large
        </item>

    </style>

    <style name="ShapeAppearance.ChatAppCircle"
        parent="ShapeAppearance.Material3.Corner.Full"
/>
    <style name="Widget.ChatApp.Button."
        parent="Widget.Material3.Button"
        >
        <item name="minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextAppearance.ChatApp.Title."
        parent="TextAppearance.Material3.HeadlineSmall"
        >
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="TextAppearance.ChatApp.Body."
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="Widget.AppCompat.Toolbar."
        parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="navigationIconTint">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.ChatApp.Toolbar."
        parent="TextAppearance.Material3.TitleMedium"
        >
        <item name="android:textColor">?attr/colorOnSurface</item>

    </style>
</resources>